    "import yfinance as yf\n",
    "import numpy as np\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "from statsmodels.tsa.stattools import coint\n",
    "\n",
    "# Better stocks — all active, good data\n",
    "symbol_list = ['XOM', 'CVX', 'SPY', 'V', 'MA', 'MSFT']\n",
    "\n",
    "prices_df = yf.download(symbol_list, start='2014-01-01',\n",
    "                        end='2015-01-01', auto_adjust=True)['Close']\n",
    "prices_df = prices_df.ffill().dropna()\n",
    "\n",
    "# Remove any columns with all zeros or constant values\n",
    "prices_df = prices_df.loc[:, (prices_df != 0).any(axis=0)]\n",
    "prices_df = prices_df.loc[:, prices_df.std() > 0]\n",
    "\n",
    "symbol_list = list(prices_df.columns)\n",
    "print(f\"Clean symbols: {symbol_list}\")\n",
    "\n",
    "def find_cointegrated_pairs(data):\n",
    "    n = data.shape[1]\n",
    "    pvalue_matrix = np.ones((n, n))\n",
    "    keys = list(data.keys())\n",
    "    pairs = []\n",
    "    for i in range(n):\n",
    "        for j in range(i+1, n):\n",
    "            try:\n",
    "                pvalue = coint(data[keys[i]], data[keys[j]])[1]\n",
    "                pvalue_matrix[i, j] = pvalue\n",
    "                if pvalue < 0.05:\n",
    "                    pairs.append((keys[i], keys[j]))\n",
    "            except:\n",
    "                pass\n",
    "    return pvalue_matrix, pairs\n",
    "\n",
    "pvalues, pairs = find_cointegrated_pairs(prices_df)\n",
    "\n",
    "sns.heatmap(pvalues, xticklabels=symbol_list, yticklabels=symbol_list,\n",
    "            cmap='RdYlGn_r', mask=(pvalues >= 0.05), annot=True, fmt='.2f')\n",
    "plt.title('Cointegration Heatmap (green = cointegrated)')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print('Cointegrated pairs:', pairs)"
   ]
  },
