    "import numpy as np \n",
    "import yfinance as yf \n",
    "import matplotlib.pyplot as plt\n",
    "import statsmodels.api as sm\n",
    "\n",
    "# ── Define linreg ──────────────────────────────────────────\n",
    "def linreg(X, Y):\n",
    "    X_const = sm.add_constant(X)\n",
    "    model   = sm.OLS(Y, X_const).fit()\n",
    "    alpha   = float(model.params[0])\n",
    "    beta    = float(model.params[1])\n",
    "    return alpha, beta\n",
    "\n",
    "# ── Data ──────────────────────────────────────────────────\n",
    "asset     = yf.download(\"TSLA\", start=\"2014-01-01\", end=\"2015-01-01\")[\"Close\"]\n",
    "benchmark = yf.download(\"SPY\",  start=\"2014-01-01\", end=\"2015-01-01\")[\"Close\"]\n",
    "\n",
    "r_a = asset.pct_change().dropna()\n",
    "r_b = benchmark.pct_change().dropna()\n",
    "\n",
    "# Align both series (same dates only)\n",
    "r_a, r_b = r_a.align(r_b, join=\"inner\")\n",
    "\n",
    "X = r_b.values\n",
    "Y = r_a.values\n",
    "\n",
    "# ── Historical estimate ────────────────────────────────────\n",
    "historical_alpha, historical_beta = linreg(X, Y)\n",
    "print(\"Asset Historical Estimate:\")\n",
    "print(\"alpha: \" + str(round(historical_alpha, 6)))\n",
    "print(\"beta:  \" + str(round(historical_beta, 4)))\n",
    "\n",
    "# ── Hedged portfolio ───────────────────────────────────────\n",
    "portfolio = -1 * historical_beta * r_b + r_a\n",
    "p = portfolio.values\n",
    "\n",
    "alpha, beta = linreg(X, p)\n",
    "print(\"\\nPortfolio Estimate:\")\n",
    "print(\"alpha: \" + str(round(alpha, 6)))\n",
    "print(\"beta:  \" + str(round(beta, 4)))\n",
    "\n",
    "# ── Plot ───────────────────────────────────────────────────\n",
    "portfolio.name = \"TSLA + Hedge\"\n",
    "portfolio.plot(alpha=0.9)\n",
    "r_a.name = \"TSLA\"\n",
    "r_a.plot(alpha=0.5)\n",
    "r_b.name = \"SPY\"\n",
    "r_b.plot(alpha=0.5)\n",
    "plt.ylabel(\"Daily Return\")\n",
    "plt.title(\"Hedged Portfolio vs Raw Returns\")\n",
    "plt.legend()\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.show()"
