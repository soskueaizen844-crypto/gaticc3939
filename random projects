    "import numpy as np\n",
    "import yfinance as yf\n",
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "\n",
    "def sharpe_ratio(asset, riskfree):\n",
    "    diff = asset.values - riskfree.values\n",
    "    if len(diff) < 2:\n",
    "        return np.nan\n",
    "    std = np.std(diff, ddof=1)\n",
    "    if std == 0:\n",
    "        return np.nan\n",
    "    return np.mean(diff) / std\n",
    "\n",
    "# ── Data ──────────────────────────────────────────────────\n",
    "pricing      = yf.download(\"AMZN\", start=\"2015-01-01\", end=\"2020-01-01\")[\"Close\"]\n",
    "treasury     = yf.download(\"BIL\",  start=\"2015-01-01\", end=\"2020-01-01\")[\"Close\"]\n",
    "\n",
    "returns      = pricing.pct_change().dropna()\n",
    "treasury_ret = treasury.pct_change().dropna()\n",
    "\n",
    "# Align both to same dates\n",
    "returns, treasury_ret = returns.align(treasury_ret, join=\"inner\")\n",
    "\n",
    "# ── Rolling 90-day Sharpe ──────────────────────────────────\n",
    "running_sharpe = []\n",
    "for i in range(90, len(returns)):\n",
    "    r  = returns.iloc[i-90:i]\n",
    "    rf = treasury_ret.iloc[i-90:i]\n",
    "    running_sharpe.append(sharpe_ratio(r, rf))\n",
    "\n",
    "# ── Plot ───────────────────────────────────────────────────\n",
    "sharpe_series = pd.Series(\n",
    "    running_sharpe,\n",
    "    index=returns.index[90:]\n",
    ")\n",
    "\n",
    "_, ax1 = plt.subplots(figsize=(12, 5))\n",
    "ax1.plot(sharpe_series.index, sharpe_series.values)\n",
    "ax1.axhline(y=0, color='red', linestyle='--', linewidth=0.8, label='Zero')\n",
    "ax1.axhline(y=1, color='green', linestyle='--', linewidth=0.8, label='Sharpe=1')\n",
    "\n",
    "plt.xlabel(\"Date\")\n",
    "plt.ylabel(\"Sharpe Ratio\")\n",
    "plt.title(\"AMZN 90-Day Rolling Sharpe Ratio\")\n",
    "plt.legend()\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
