   "source": [
    "\"\"\"\n",
    "GOLD CROSS-ASSET STRATEGY - POLYGON FREE TIER v4\n",
    "Ray Tanvar | @sharpmind_98\n",
    "\n",
    "v4 FIXES:\n",
    "- position column as float (fixes LossySetitemError)\n",
    "- All previous fixes maintained\n",
    "\"\"\"\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import time\n",
    "from polygon import RESTClient\n",
    "from sklearn.mixture import GaussianMixture\n",
    "\n",
    "API_KEY = \"",
    "client = RESTClient(API_KEY)\n",
    "\n",
    "END_DATE = \"2025-08-01\"\n",
    "START_DATE = \"2023-08-01\"\n",
    "\n",
    "def fetch_close(ticker, from_date, to_date):\n",
    "    aggs = []\n",
    "    try:\n",
    "        for agg in client.list_aggs(\n",
    "            ticker=ticker, multiplier=1, timespan=\"day\",\n",
    "            from_=from_date, to=to_date, limit=50000):\n",
    "            aggs.append(agg)\n",
    "    except Exception as e:\n",
    "        print(f\"❌ {ticker}: {e}\")\n",
    "        return pd.Series(dtype=float, name='close')\n",
    "\n",
    "    if not aggs:\n",
    "        print(f\"⚠️ No data for {ticker}\")\n",
    "        return pd.Series(dtype=float, name='close')\n",
    "\n",
    "    df = pd.DataFrame([{\n",
    "        'date': pd.to_datetime(a.timestamp, unit='ms').normalize(),\n",
    "        'close': a.close,\n",
    "    } for a in aggs])\n",
    "    df = df.groupby('date').last()\n",
    "    print(f\"✅ {ticker}: {len(df)} unique days\")\n",
    "    return df['close']\n",
    "\n",
    "\n",
    "print(\"Fetching data...\\n\")\n",
    "print(\"1/4 Gold...\")\n",
    "gold = fetch_close(\"C:XAUUSD\", START_DATE, END_DATE)\n",
    "time.sleep(15)\n",
    "print(\"2/4 UUP...\")\n",
    "dxy = fetch_close(\"UUP\", START_DATE, END_DATE)\n",
    "time.sleep(15)\n",
    "print(\"3/4 SPY...\")\n",
    "spy = fetch_close(\"SPY\", START_DATE, END_DATE)\n",
    "time.sleep(15)\n",
    "print(\"4/4 TLT...\")\n",
    "tlt = fetch_close(\"TLT\", START_DATE, END_DATE)\n",
    "\n",
    "data = pd.DataFrame({'gold': gold, 'dxy': dxy, 'spy': spy, 'tlt': tlt})\n",
    "data = data.ffill().dropna()\n",
    "\n",
    "if len(data) == 0:\n",
    "    print(\"❌ No overlapping data\")\n",
    "    exit()\n",
    "\n",
    "print(f\"\\n✅ Data: {len(data)} days | {data.index[0].date()} to {data.index[-1].date()}\")\n",
    "\n",
    "# ============================================================\n",
    "# FEATURES\n",
    "# ============================================================\n",
    "returns = data['gold'].pct_change()\n",
    "features = pd.DataFrame(index=data.index)\n",
    "features['gold_mom_20'] = data['gold'].pct_change(20)\n",
    "features['dxy_mom_20'] = data['dxy'].pct_change(20)\n",
    "features['spy_mom_20'] = data['spy'].pct_change(20)\n",
    "features['tlt_mom_20'] = data['tlt'].pct_change(20)\n",
    "features['vol'] = returns.rolling(20).std()\n",
    "features['gold_ma_ratio'] = (data['gold'] / data['gold'].rolling(50).mean()) - 1\n",
    "features = features.dropna()\n",
    "\n",
    "# ============================================================\n",
    "# STATE BINNING\n",
    "# ============================================================\n",
    "bins = pd.DataFrame(index=features.index)\n",
    "for col in ['gold_mom_20', 'dxy_mom_20', 'spy_mom_20', 'tlt_mom_20']:\n",
    "    ranked = features[col].rank(method='first')\n",
    "    bins[col + '_bin'] = pd.qcut(ranked, q=3, labels=[0, 1, 2]).astype(int)\n",
    "\n",
    "bins['state'] = (bins['gold_mom_20_bin'] * 27 +\n",
    "                 bins['dxy_mom_20_bin'] * 9 +\n",
    "                 bins['spy_mom_20_bin'] * 3 +\n",
    "                 bins['tlt_mom_20_bin'])\n",
    "bins['next_ret'] = returns.shift(-1).reindex(bins.index)\n",
    "\n",
    "# ============================================================\n",
    "# GMM REGIMES\n",
    "# ============================================================\n",
    "gmm = GaussianMixture(n_components=3, covariance_type='full',\n",
    "                     random_state=42, n_init=10)\n",
    "gmm.fit(features[['vol', 'gold_ma_ratio']].values)\n",
    "bins['regime'] = gmm.predict(features[['vol', 'gold_ma_ratio']].values)\n",
    "\n",
    "regime_vol = pd.DataFrame({'regime': bins['regime'].values,\n",
    "                          'vol': features['vol'].values}).groupby('regime')['vol'].mean()\n",
    "sorted_regimes = regime_vol.sort_values()\n",
    "regime_labels = {sorted_regimes.index[0]: 'CALM',\n",
    "                sorted_regimes.index[1]: 'NORMAL',\n",
    "                sorted_regimes.index[2]: 'CRISIS'}\n",
    "\n",
    "print(f\"\\nRegimes: {dict(zip(regime_labels.values(), [(bins['regime'] == k).sum() for k in regime_labels.keys()]))}\")\n",
    "\n",
    "# ============================================================\n",
    "# IS/OOS SPLIT + SIGNAL (FIXED: use float)\n",
    "# ============================================================\n",
    "split_idx = int(len(bins) * 0.6)\n",
    "train = bins.iloc[:split_idx]\n",
    "\n",
    "state_stats = train.groupby('state').agg(\n",
    "    count=('state', 'size'),\n",
    "    avg_ret=('next_ret', 'mean')\n",
    ")\n",
    "reliable = state_stats[state_stats['count'] >= 5]\n",
    "bullish_states = reliable[reliable['avg_ret'] > 0.001].index.tolist()\n",
    "bearish_states = reliable[reliable['avg_ret'] < -0.001].index.tolist()\n",
    "\n",
    "print(f\"Train: {len(train)} | Test: {len(bins) - split_idx}\")\n",
    "print(f\"Bullish: {len(bullish_states)} | Bearish: {len(bearish_states)}\")\n",
    "\n",
    "# ⭐ FIX: Use FLOAT dtype for position\n",
    "bins['position'] = 0.0  # Float, not int\n",
    "bins.loc[bins['state'].isin(bullish_states), 'position'] = 1.0\n",
    "bins.loc[bins['state'].isin(bearish_states), 'position'] = -1.0\n",
    "\n",
    "# Now crisis filter works\n",
    "crisis_regime = [k for k, v in regime_labels.items() if v == 'CRISIS'][0]\n",
    "bins.loc[bins['regime'] == crisis_regime, 'position'] *= 0.5\n",
    "\n",
    "# ============================================================\n",
    "# VOL-BASED SIZING\n",
    "# ============================================================\n",
    "vol_target = 0.15\n",
    "current_vol = features['vol'].reindex(bins.index) * np.sqrt(252)\n",
    "position_size = (vol_target / current_vol).clip(0.5, 2.0)\n",
    "bins['sized_position'] = bins['position'] * position_size\n",
    "\n",
    "# ============================================================\n",
    "# BACKTEST\n",
    "# ============================================================\n",
    "bins['strategy_ret'] = bins['sized_position'].shift(1) * bins['next_ret']\n",
    "bins = bins.dropna()\n",
    "\n",
    "trades = bins['sized_position'].diff().abs()\n",
    "bins['strategy_ret_net'] = bins['strategy_ret'] - trades * 0.0005\n",
    "\n",
    "# ============================================================\n",
    "# METRICS\n",
    "# ============================================================\n",
    "def compute_metrics(returns, name):\n",
    "    if len(returns) == 0 or returns.std() == 0:\n",
    "        return {'name': name, 'ann_ret': 0, 'sharpe': 0, 'max_dd': 0,\n",
    "                'sortino': 0, 'calmar': 0, 'win_rate': 0, 'ann_vol': 0}\n",
    "\n",
    "    ann_ret = returns.mean() * 252 * 100\n",
    "    ann_vol = returns.std() * np.sqrt(252) * 100\n",
    "    sharpe = (returns.mean() / returns.std()) * np.sqrt(252)\n",
    "\n",
    "    downside = returns[returns < 0]\n",
    "    sortino = (returns.mean() / downside.std()) * np.sqrt(252) if len(downside) > 0 and downside.std() > 0 else 0\n",
    "\n",
    "    equity = (1 + returns).cumprod()\n",
    "    dd = ((equity - equity.cummax()) / equity.cummax()).min() * 100\n",
    "    calmar = ann_ret / abs(dd) if dd != 0 else 0\n",
    "\n",
    "    wins = (returns > 0).sum()\n",
    "    total = (returns != 0).sum()\n",
    "    win_rate = wins / total * 100 if total > 0 else 0\n",
    "\n",
    "    return {'name': name, 'ann_ret': ann_ret, 'ann_vol': ann_vol,\n",
    "            'sharpe': sharpe, 'sortino': sortino, 'max_dd': dd,\n",
    "            'calmar': calmar, 'win_rate': win_rate}\n",
    "\n",
    "train_end = train.index[-1]\n",
    "train_m = compute_metrics(bins.loc[bins.index <= train_end, 'strategy_ret_net'], \"In-Sample\")\n",
    "test_m = compute_metrics(bins.loc[bins.index > train_end, 'strategy_ret_net'], \"Out-of-Sample ⭐\")\n",
    "gold_m = compute_metrics(bins['next_ret'], \"Buy & Hold Gold\")\n",
    "\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"RESULTS\")\n",
    "print(\"=\"*60)\n",
    "for m in [train_m, test_m, gold_m]:\n",
    "    print(f\"\\n{m['name']}:\")\n",
    "    print(f\"  Ann Return:   {m['ann_ret']:+.2f}%\")\n",
    "    print(f\"  Ann Vol:      {m['ann_vol']:.2f}%\")\n",
    "    print(f\"  Sharpe:       {m['sharpe']:.2f}\")\n",
    "    print(f\"  Sortino:      {m['sortino']:.2f}\")\n",
    "    print(f\"  Max DD:       {m['max_dd']:.2f}%\")\n",
    "    print(f\"  Calmar:       {m['calmar']:.2f}\")\n",
    "    print(f\"  Win Rate:     {m['win_rate']:.1f}%\")\n",
    "\n",
    "oos = bins.loc[bins.index > train_end, 'strategy_ret_net']\n",
    "if len(oos) > 0 and oos.std() > 0:\n",
    "    t_stat = oos.mean() / (oos.std() / np.sqrt(len(oos)))\n",
    "    print(f\"\\nT-Stat (OOS): {t_stat:.2f}\")\n",
    "    print(f\"{'✅ Significant edge' if abs(t_stat) > 2 else '⚠️ Not significant'}\")\n",
    "\n",
    "print(\"\\n\" + \"=\"*60)"
